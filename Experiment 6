# 0/1 Knapsack Problem - Bottom-Up Approach
# Advanced Python
# Dynamic Programming

def knapsack_bottom_up(values, weights, W):
    n = len(values)

    # Create DP table
    dp = [[0 for _ in range(W + 1)] for _ in range(n + 1)]

    # Fill the DP table
    for i in range(1, n + 1):
        for w in range(W + 1):

            if weights[i - 1] <= w:
                dp[i][w] = max(
                    dp[i - 1][w],
                    dp[i - 1][w - weights[i - 1]] + values[i - 1]
                )
            else:
                dp[i][w] = dp[i - 1][w]

    return dp[n][W]


# Main Program
if __name__ == "__main__":

    # Values of items
    values = [60, 100, 120]

    # Weights of items
    weights = [10, 20, 30]

    # Maximum capacity of the knapsack
    W = 50

    # Calculate maximum value
    result = knapsack_bottom_up(values, weights, W)

    print("Values:", values)
    print("Weights:", weights)
    print("Knapsack Capacity:", W)
    print("Maximum Value:", result)
